includes:
    - config.neon

services:
    - BrandEmbassyTest\Slim\Sample\RequiredPermissionsHeaderMiddleware

slimApi:
    routes:
        "app":
            "/permissions-declared":
                get:
                    service: BrandEmbassyTest\Slim\Sample\HelloWorldRoute
                    permissions: [deChannelsSettings:Edit, Users:View]
            "/permissions-empty":
                get:
                    service: BrandEmbassyTest\Slim\Sample\HelloWorldRoute
                    permissions: []

    beforeRouteMiddlewares:
        - BrandEmbassyTest\Slim\Sample\RequiredPermissionsHeaderMiddleware
