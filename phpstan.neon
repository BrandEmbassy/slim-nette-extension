includes:
    - vendor/brandembassy/coding-standard/default-phpstan.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - vendor/marc-mabe/php-enum-phpstan/extension.neon
    - phar://vendor/phpstan/phpstan/phpstan.phar/conf/bleedingEdge.neon

parameters:
    level: 8
    paths:
        - src
        - tests

    tmpDir: temp/phpstan

    ignoreErrors:
        -
            # Request is a pure PSR-7 delegation wrapper — @param annotations
            # are required by ECS but narrower than PSR-7's bare `array` parameters.
            message: '#should be contravariant with parameter#'
            path: src/Request/Request.php
        -
            message: '#Cognitive complexity for "BrandEmbassy\\Slim\\Route\\OnlyNecessaryRoutesProvider::getRoutes\(\)" is 14, keep it under 9#'
            path: src/Route/OnlyNecessaryRoutesProvider.php
        -
            # Slim 4 generic classes (App, Route, RouteCollectorProxyInterface) carry a
            # TContainerInterface type parameter. We intentionally omit the container type
            # here because it would couple these files to the concrete container choice.
            message: '#does not specify its types: TContainerInterface#'
            paths:
                - src/Request/Request.php
                - src/Request/RequestInterface.php
                - src/Route/RouteRegister.php
                - src/SlimApp.php
                - src/SlimApplicationFactory.php
